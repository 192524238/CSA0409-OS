4. C-SCAN and LOOK
Code
def cscan(requests, head, disk_size):
    right = sorted([r for r in requests if r >= head])
    left = sorted([r for r in requests if r < head])

    sequence = right + [disk_size - 1, 0] + left

    seek = 0
    current = head

    for r in sequence:
        seek += abs(current - r)
        current = r

    return sequence, seek


def look(requests, head):
    right = sorted([r for r in requests if r >= head])
    left = sorted([r for r in requests if r < head])

    sequence = right + left[::-1]

    seek = 0
    current = head

    for r in sequence:
        seek += abs(current - r)
        current = r

    return sequence, seek


