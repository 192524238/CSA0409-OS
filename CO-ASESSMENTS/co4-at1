def contiguous_allocation(total_blocks, file_size):
    disk = [0] * total_blocks

    # Already allocated blocks
    disk[2] = 1
    disk[3] = 1
    disk[10] = 1

    for start in range(total_blocks - file_size + 1):

        if all(disk[i] == 0
               for i in range(start, start + file_size)):

            blocks = []

            for i in range(start, start + file_size):
                disk[i] = 1
                blocks.append(i)

            return blocks

    return []


def fcfs(requests, head):
    sequence = []
    seek = 0

    for r in requests:
        seek += abs(head - r)
        sequence.append(r)
        head = r

    return sequence, seek


def sstf(requests, head):
    requests = requests.copy()
    sequence = []
    seek = 0

    while requests:
        nearest = min(requests,
                      key=lambda x: abs(head - x))

        seek += abs(head - nearest)
        sequence.append(nearest)
        head = nearest

        requests.remove(nearest)

    return sequence, seek


