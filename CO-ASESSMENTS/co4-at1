3. FCFS, SSTF and SCAN
Code
def fcfs(requests, head):
    sequence = []
    seek = 0

    for r in requests:
        seek += abs(head - r)
        sequence.append(r)
        head = r

    return sequence, seek


def sstf(requests, head):
    requests = requests.copy()
    sequence = []
    seek = 0

    while requests:
        nearest = min(requests, key=lambda x: abs(head - x))

        seek += abs(head - nearest)
        sequence.append(nearest)
        head = nearest

        requests.remove(nearest)

    return sequence, seek


def scan(requests, head, disk_size):
    left = sorted([r for r in requests if r < head])
    right = sorted([r for r in requests if r >= head])

    sequence = right + [disk_size - 1] + left[::-1]

    seek = 0
    current = head

    for r in sequence:
        seek += abs(current - r)
        current = r

    return sequence, seek


