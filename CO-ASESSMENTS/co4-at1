def allocate(bitmap, blocks):
    free_blocks = []

    for i in range(len(bitmap)):
        if bitmap[i] == 0:
            free_blocks.append(i)

            if len(free_blocks) == blocks:
                break

    if len(free_blocks) < blocks:
        print("Not enough free blocks")
        return

    for i in free_blocks:
        bitmap[i] = 1

    print("Allocated blocks:", free_blocks)
    print("Updated bitmap:", bitmap)


def deallocate(bitmap, blocks):
    for i in blocks:
        bitmap[i] = 0

    print("Deallocated blocks:", blocks)
    print("Updated bitmap:", bitmap)


