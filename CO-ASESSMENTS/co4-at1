1. File Allocation Methods
Code
def contiguous(disk, size):
    for i in range(len(disk) - size + 1):
        if all(disk[j] == 0 for j in range(i, i + size)):
            for j in range(i, i + size):
                disk[j] = 1
            return list(range(i, i + size))
    return []


def linked(disk, size):
    free = [i for i in range(len(disk)) if disk[i] == 0]

    if len(free) < size:
        return []

    for i in free[:size]:
        disk[i] = 1

    return free[:size]


def indexed(disk, size):
    free = [i for i in range(len(disk)) if disk[i] == 0]

    if len(free) < size + 1:
        return []

    index_block = free[0]
    data_blocks = free[1:size + 1]

    disk[index_block] = 1

    for i in data_blocks:
        disk[i] = 1

    return [index_block] + data_blocks


