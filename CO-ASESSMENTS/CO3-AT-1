5. Memory Protection using Base and Limit Registers
PROGRAM:
#include <stdio.h>

int main() {
    int base, limit, address;

    printf("Enter Base Register: ");
    scanf("%d", &base);

    printf("Enter Limit Register: ");
    scanf("%d", &limit);

    printf("Enter Address: ");
    scanf("%d", &address);

    if (address >= base && address < base + limit) {
        printf("Access Allowed\n");
    } else {
        printf("Access Denied\n");
    }

    return 0;
}
OUTPUT(ALLOWED):
Enter Base Register: 1000
Enter Limit Register: 500
Enter Address: 1200
Access Allowed

OUTPUT(DENIED):
Enter Base Register: 1000
Enter Limit Register: 500
Enter Address: 1700
Access Denied


