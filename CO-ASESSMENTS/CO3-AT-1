2. Paging Memory Management
PROGRAM:
#include <stdio.h>
int main() {
    int pageTable[5] = {3, 1, 4, 2, 0};
    int page, offset;
    int pageSize = 100;
    int physical;
    printf("Enter Page Number (0-4): ");
    scanf("%d", &page);
    printf("Enter Offset: ");
    scanf("%d", &offset);
    if (page >= 0 && page < 5 && offset < pageSize) {
        physical = pageTable[page] * pageSize + offset;
        printf("Physical Address = %d\n", physical);
    } else {
        printf("Invalid Address\n");
    }
    return 0;
}
OUTPUT:
Enter Page Number (0-4): 2
Enter Offset: 45
Physical Address = 445
