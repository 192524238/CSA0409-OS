3. Page Table Simulation
PROGRAM:
#include <stdio.h>

int main() {
    int n, page, offset, pageSize = 100;

    printf("Enter number of pages: ");
    scanf("%d", &n);

    int pageTable[n];

    printf("Enter Frame Numbers:\n");
    for (int i = 0; i < n; i++) {
        printf("Page %d -> ", i);
        scanf("%d", &pageTable[i]);
    }

    printf("Enter Page Number: ");
    scanf("%d", &page);

    printf("Enter Offset: ");
    scanf("%d", &offset);

    if (page < n && offset < pageSize) {
        printf("Frame Number = %d\n", pageTable[page]);
        printf("Physical Address = %d\n",
               pageTable[page] * pageSize + offset);
    } else {
        printf("Invalid Address\n");
    }

    return 0;
}
OUTPUT:
Enter number of pages: 3
Enter Frame Numbers:
Page 0 -> 5
Page 1 -> 2
Page 2 -> 7
Enter Page Number: 1
Enter Offset: 20
Frame Number = 2
Physical Address = 220
